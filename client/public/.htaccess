<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Set default directory index
  DirectoryIndex index.php index.html

  # Do not apply to server API directory
  RewriteCond %{REQUEST_URI} ^/server/ [NC]
  RewriteRule ^ - [L]

  # Dynamic SEO & AEO endpoints
  RewriteRule ^llms\.txt$ /server/api/llms.php [L]
  RewriteRule ^ai\.txt$ /server/api/llms.php [L]
  RewriteRule ^robots\.txt$ /server/api/robots.php [L]
  RewriteRule ^sitemap\.xml$ /server/api/sitemap.php [L]

  # Route direct index.html requests to index.php
  RewriteRule ^index\.html$ /index.php [L]
  RewriteRule ^index\.php$ - [L]

  # Route all non-file/directory requests to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

# ─── Performance Boost: Compression & Caching ──────────────────────────

# Enable Gzip compression (deflate)
<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML, JSON and SVG
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml image/svg+xml
  
  # Remove browser bugs for older browsers
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# Enable browser caching (Expires headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Cache CSS, Javascript for 1 week
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  
  # Cache media files for 1 month
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 week"
  
  # Cache webfonts for 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Disable ETag headers to reduce payload and roundtrips
FileETag None
