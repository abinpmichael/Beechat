<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not apply to server API directory
  RewriteCond %{REQUEST_URI} ^/server/ [NC]
  RewriteRule ^ - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
