<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Set default directory index
  DirectoryIndex index.php index.html

  # Do not apply to server API directory
  RewriteCond %{REQUEST_URI} ^/server/ [NC]
  RewriteRule ^ - [L]

  # Dynamic SEO & AEO endpoints
  RewriteRule ^llms\.txt$ /server/api/llms.php [L]
  RewriteRule ^ai\.txt$ /server/api/llms.php [L]
  RewriteRule ^robots\.txt$ /server/api/robots.php [L]
  RewriteRule ^sitemap\.xml$ /server/api/sitemap.php [L]

  # Route direct index.html requests to index.php
  RewriteRule ^index\.html$ /index.php [L]
  RewriteRule ^index\.php$ - [L]

  # Route all non-file/directory requests to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>
